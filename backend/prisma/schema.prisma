generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BillingCycle {
  MONTHLY
  ANNUAL
  ONE_OFF
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
}

enum UserRole {
  ADMIN
  MEMBER
  VIEWER
}

enum LicenseType {
  INDIVIDUAL
  TEAM
}

enum ApiProvider {
  CURSOR
  ANTHROPIC
}

model Project {
  id             String         @id @default(cuid())
  name           String         @unique
  monthlyBudget  Decimal?       @db.Decimal(12, 2)
  budgetCurrency String         @default("USD")
  subscriptions  Subscription[]
  createdAt      DateTime       @default(now())
}

model Subscription {
  id             String             @id @default(cuid())
  month          String
  serviceName    String
  vendor         String
  billingCycle   BillingCycle
  nativeCost     Decimal            @db.Decimal(12, 2)
  currency       String
  usdMonthlyCost Decimal            @db.Decimal(12, 2)
  paymentMode    String
  renewalDate    DateTime
  status         SubscriptionStatus @default(ACTIVE)
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id])
  seats          Seat[]
  invoices       Invoice[]
  createdAt      DateTime           @default(now())
}

model Seat {
  id             String       @id @default(cuid())
  name           String
  email          String
  licenseType    LicenseType  @default(INDIVIDUAL)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([email, subscriptionId])
}

model Invoice {
  id             String       @id @default(cuid())
  billingPeriod  String
  fileName       String
  filePath       String
  amount         Decimal      @db.Decimal(12, 2)
  invoiceDate    DateTime
  ocrAmount      Decimal?     @db.Decimal(12, 2)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())
}

model ApiCredential {
  id              String      @id @default(cuid())
  subscriptionId  String      @unique
  provider        ApiProvider
  apiKeyEncrypted String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model UsageRecord {
  id               String   @id @default(cuid())
  subscriptionId   String
  date             DateTime @db.Date
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)
  requestCount     Int      @default(0)
  costUsd          Decimal? @db.Decimal(12, 4)
  createdAt        DateTime @default(now())

  @@unique([subscriptionId, date])
}
